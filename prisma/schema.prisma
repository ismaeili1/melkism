datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// ۱. نقش‌ها و وضعیت‌های کاربری (User Roles & Statuses)
// ------------------------------------------------------

enum UserRole {
  GUEST
  USER
  EXPERT
  AGENCY
  COMPANY
  MANAGER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
}

model User {
  id        String     @id @default(cuid())
  name      String?
  username  String?    @unique
  email     String?    @unique
  mobile    String?    @unique
  password  String?
  role      UserRole   @default(USER)
  status    UserStatus @default(PENDING)

  province  String?
  city      String?
  iban      String?
  bankName  String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // روابط معکوس برای معاملات اسکرو
  buyerTransactions    EscrowTransaction[] @relation("BuyerTransactions")
  sellerTransactions   EscrowTransaction[] @relation("SellerTransactions")

  @@index([email])
  @@index([mobile])
}

// ------------------------------------------------------
// ۲. ماتریس پویای دسترسی‌ها (Dynamic RBAC Engine)
// ------------------------------------------------------

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // مانند: "MANAGE_USERS", "APPROVE_NEWS", "MANAGE_ESCROW"
  name        String           // نام نمایشی 
  description String?          // توضیحات کاربرد
  category    String?          // دسته‌بندی (امنیتی، مالی، محتوایی، پنل‌ها)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         UserRole   // استفاده از اِنام امن برای نقش‌ها
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(false)

  @@unique([role, permissionId])
}

// ------------------------------------------------------
// ۳. سیستم معاملات امن و حساب‌های واسط (Escrow Engine)
// ------------------------------------------------------

enum EscrowStatus {
  PENDING_DEPOSIT        // در انتظار واریز وجه توسط خریدار
  DEPOSITED_IN_ESCROW    // وجه با موفقیت در حساب واسط (اسکرو) مسدود شد
  UNDER_INSPECTION       // در مرحله بازرسی و تایید کارشناس/مدیر
  RELEASED               // وجه به حساب فروشنده/سازنده آزاد شد
  REFUNDED               // وجه به خریدار مرجوع شد
  DISPUTED               // دارای اختلاف مالی / مسدود جهت داوری
}

model EscrowTransaction {
  id            String       @id @default(cuid())
  trackingCode  String       @unique // کد رهگیری یکتا تراکنش
  propertyId    String?      // شناسه ملک مربوطه (در صورت وجود)
  
  buyerId       String       // شناسه کاربر خریدار
  buyer         User         @relation("BuyerTransactions", fields: [buyerId], references: [id])
  
  sellerId      String       // شناسه فروشنده/آژانس/شرکت
  seller        User         @relation("SellerTransactions", fields: [sellerId], references: [id])

  amount        Float        // مبلغ معامله
  platformFee   Float        @default(0) // کمیسیون پلتفرم ملکیسم
  status        EscrowStatus @default(PENDING_DEPOSIT)
  
  description   String?      // توضیحات توافق‌نامه
  bankRef       String?      // شماره ارجاع بانکی پس از واریز
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  logs          EscrowLog[]

  @@index([trackingCode])
  @@index([status])
}

model EscrowLog {
  id            String            @id @default(cuid())
  transactionId String
  transaction   EscrowTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  actorId       String            // کاربری که عملیات را انجام داده
  action        String            // شرح عملیات
  notes         String?
  createdAt     DateTime          @default(now())
}

// ------------------------------------------------------
// ۴. بخش‌های محتوایی با «روش جدول ترجمه مجزا» (Translations Tables)
// پشتیبانی کامل از ۱۰ زبان: fa, en, de, fr, es, it, tr, zh, ar, ru
// ------------------------------------------------------

// --- اخبار و مقالات (News) ---
model News {
  id          String           @id @default(cuid())
  slug        String           @unique
  category    String           @default("عمومی")
  imageUrl    String?          // لینک تصویر شاخص خبر
  published   Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  translations NewsTranslation[]

  @@index([slug])
}

model NewsTranslation {
  id          String   @id @default(cuid())
  newsId      String
  locale      String   // کد زبان (fa, en, de, ...)
  title       String
  summary     String   @db.Text
  content     String   @db.Text

  news        News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, locale])
  @@index([locale])
  @@map("news_translations")
}

// --- گزارش‌های هوش بازار (Market Reports) ---
model MarketReport {
  id          String                    @id @default(cuid())
  slug        String                    @unique
  marketIndex Float?
  region      String?
  pdfLink     String?
  imageUrl    String?                   // لینک تصویر/انفوگرافیک گزارش
  createdAt   DateTime                  @default(now())

  translations MarketReportTranslation[]

  @@index([slug])
  @@index([region])
}

model MarketReportTranslation {
  id          String       @id @default(cuid())
  reportId    String
  locale      String
  title       String
  description String       @db.Text

  report      MarketReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, locale])
  @@index([locale])
  @@map("market_report_translations")
}

// --- قوانین و مقررات (Regulations) ---
model Regulation {
  id         String                  @id @default(cuid())
  codeNumber String                  @unique
  category   String
  imageUrl   String?                 // لینک تصویر/سند قانون
  createdAt  DateTime                @default(now())

  translations RegulationTranslation[]

  @@index([codeNumber])
}

model RegulationTranslation {
  id           String     @id @default(cuid())
  regulationId String
  locale       String
  title        String
  fullText     String     @db.Text

  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)

  @@unique([regulationId, locale])
  @@index([locale])
  @@map("regulation_translations")
}

// --- املاک و آگهی‌ها (Properties) ---
model Property {
  id          String                @id @default(cuid())
  slug        String                @unique
  price       Float
  area        Float
  province    String
  city        String
  imageUrl    String?               // لینک تصویر اصلی ملک
  gallery     String[]              // آرایه‌ای از لینک‌های تصاویر گالری
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  translations PropertyTranslation[]

  @@index([slug])
  @@index([city])
  @@index([province])
  @@index([price])
}

model PropertyTranslation {
  id          String   @id @default(cuid())
  propertyId  String
  locale      String
  title       String
  description String   @db.Text
  address     String

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, locale])
  @@index([locale])
  @@map("property_translations")
}

// --- کتابخانه تخصصی (Library Documents) ---
model LibraryDocument {
  id          String               @id @default(cuid())
  slug        String               @unique
  author      String?
  category    String?              // کتاب، آیین‌نامه، مقاله علمی
  downloadUrl String?
  imageUrl    String?              // لینک تصویر جلد کتاب/سند
  createdAt   DateTime             @default(now())

  translations LibraryTranslation[]

  @@index([slug])
}

model LibraryTranslation {
  id         String          @id @default(cuid())
  documentId String
  locale     String
  title      String
  summary    String          @db.Text

  document   LibraryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, locale])
  @@index([locale])
  @@map("library_translations")
}

// --- متخصصین ملکیست - پروفایل VIP (Expert Profiles) ---
model ExpertProfile {
  id            String              @id @default(cuid())
  licenseNumber String?             @unique
  city          String
  mobile        String?
  isVip         Boolean             @default(false) // نشان VIP
  avatarUrl     String?             // آواتار / تصویر پرسنلی
  rating        Float               @default(5.0)
  createdAt     DateTime            @default(now())

  translations ExpertTranslation[]

  @@index([city])
  @@index([isVip])
}

model ExpertTranslation {
  id        String        @id @default(cuid())
  expertId  String
  locale    String
  name      String
  bio       String        @db.Text
  specialty String

  expert    ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@unique([expertId, locale])
  @@index([locale])
  @@map("expert_translations")
}

// --- بازار ملکیست (Market Items) ---
model MarketItem {
  id          String                  @id @default(cuid())
  slug        String                  @unique
  category    String                  // مصالح ساختمانی، تجهیزات، خدمات مهندسی
  price       Float?
  supplier    String                  // تامین‌کننده / شرکت
  city        String
  imageUrl    String?                 // تصویر محصول / خدمت
  createdAt   DateTime                @default(now())

  translations MarketItemTranslation[]

  @@index([slug])
  @@index([category])
  @@index([city])
}

model MarketItemTranslation {
  id          String     @id @default(cuid())
  itemId      String
  locale      String
  title       String
  description String     @db.Text

  item        MarketItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, locale])
  @@index([locale])
  @@map("market_item_translations")
}

// ------------------------------------------------------
// ۵. مخزن متمرکز رسانه و تصاویر (Media Library Engine)
// ------------------------------------------------------

enum MediaType {
  IMAGE
  DOCUMENT
  PDF
  ARCHIVE
}

model MediaAsset {
  id           String    @id @default(cuid())
  title        String?   // عنوان یا توضیح تصویر
  filename     String    // نام فایل ذخیره‌شده یا نام مستعار
  originalName String?   // نام اصلی هنگام آپلود
  url          String    // آدرس نهایی دسترسی
  mimeType     String?   // image/jpeg, image/png, etc.
  size         Int?      // حجم فایل به بایت
  width        Int?      // عرض به پیکسل
  height       Int?      // ارتفاع به پیکسل
  category     String    // دسته‌بندی: news, properties, experts, library, market, general
  folderPath   String?   // مسیر فولدر مجازی
  altText      String?   // متن جایگزین برای سئو (SEO)
  uploadedBy   String?   // شناسه کاربر آپلودکننده
  isUrlSource  Boolean   @default(false) // آیا از طریق URL خارجی ثبت شده؟
  createdAt    DateTime  @default(now())

  @@index([category])
}