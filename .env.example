# MELKISM Environment Configuration
# Copy this file to .env.local for local development.

NODE_ENV=development

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/melkism"

# Application
NEXT_PUBLIC_APP_NAME="MELKISM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE="fa"

# Future MELKIST integration
# Keep disabled during Foundation phase.
MELKIST_INTEGRATION_ENABLED="false"
MELKIST_API_BASE_URL=""
MELKIST_API_KEY=""
AUTH_SECRET=

