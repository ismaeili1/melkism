<PropertyRecord | null> {\n    return this.repository.getBySlug(slug);\n  }\n\n  async updateStatus(\n    id: string,\n    status: PropertyStatus\n  ): Promise<PropertyRecord | null> {\n    const property = await this.repository.getById(id);\n\n    if (!property) {\n      return null;\n    }\n\n    return this.repository.update({\n      ...property,\n      status,\n      updatedAt: new Date().toISOString(),\n    });\n  }\n\n  async list(limit = 50): Promise<PropertyRecord[]> {\n    return this.repository.list(limit);\n  }\n}","usedDeprecatedRules":[]},{"filePath":"C:\\Projects\\melkism\\lib\\property-platform\\property.types.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Projects\\melkism\\lib\\property-platform\\property.utils.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]}]